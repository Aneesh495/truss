#!/usr/bin/env python3
"""
Truss UPF Administrative Control CLI (trussctl)
Interacts with the Truss 5G User Plane Function embedded admin HTTP REST API
to retrieve telemetry, session states, health diagnostics, and metrics.
"""

import argparse
import json
import sys
import time
import urllib.error
import urllib.request


def fetch_endpoint(base_url: str, endpoint: str, timeout: float = 3.0) -> tuple[int, str]:
    """
    Execute HTTP GET request against the Truss management endpoint.
    Returns HTTP status code and response body text.
    """
    url = f"{base_url.rstrip('/')}{endpoint}"
    req = urllib.request.Request(
        url,
        headers={"User-Agent": "trussctl/1.0", "Accept": "application/json, text/plain"}
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            body = response.read().decode("utf-8", errors="replace")
            return response.status, body
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        return exc.code, body
    except urllib.error.URLError as exc:
        print(f"[ERROR] Could not connect to Truss management endpoint at {url}: {exc.reason}", file=sys.stderr)
        sys.exit(1)


def cmd_health(args: argparse.Namespace) -> None:
    """Check UPF health status."""
    status, body = fetch_endpoint(args.url, "/healthz")
    if args.json:
        print(json.dumps({"status": status, "body": body.strip()}))
        return

    if status == 200:
        print(f"[OK] Truss UPF is healthy (HTTP {status})")
        print(f"     Response: {body.strip()}")
    else:
        print(f"[WARN] Truss UPF reported unhealthy status: HTTP {status}")
        print(f"       Details: {body.strip()}", file=sys.stderr)
        sys.exit(1)


def cmd_status(args: argparse.Namespace) -> None:
    """Retrieve detailed node status and subsystem diagnostics."""
    status, body = fetch_endpoint(args.url, "/status")
    if args.json:
        try:
            parsed = json.loads(body)
            print(json.dumps(parsed, indent=2))
        except json.JSONDecodeError:
            print(body)
        return

    print("=================================================================")
    print("                     TRUSS 5G UPF NODE STATUS                    ")
    print("=================================================================")
    try:
        data = json.loads(body)
        print(f"Node Name:        {data.get('node', 'truss-upf-primary')}")
        print(f"Status:           {data.get('status', 'RUNNING')}")
        print(f"Uptime:           {data.get('uptime_seconds', 0)} seconds")
        print(f"Active Sessions:  {data.get('active_sessions', 0)}")
        print(f"PFCP State:       {data.get('pfcp_state', 'ASSOCIATED')}")
        print(f"GTP-U Endpoint:   {data.get('gtpu_endpoint', '0.0.0.0:2152')}")
        print(f"Admin Endpoint:   {data.get('admin_endpoint', '0.0.0.0:8080')}")
        print("-----------------------------------------------------------------")
        print(f"Memory Allocator: Pony Runtime Pool (Zero Lock-Contention)")
        print(f"Fastpath Engine:  C AVX2 / NEON Accelerated 24-8 LPM Trie")
        print("=================================================================")
    except json.JSONDecodeError:
        print(body)


def cmd_metrics(args: argparse.Namespace) -> None:
    """Fetch OpenMetrics / Prometheus telemetry stream."""
    status, body = fetch_endpoint(args.url, "/metrics")
    if args.json:
        parsed_metrics = {}
        for line in body.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            if len(parts) >= 2:
                key, val = parts[0], parts[1]
                try:
                    parsed_metrics[key] = float(val) if "." in val else int(val)
                except ValueError:
                    parsed_metrics[key] = val
        print(json.dumps(parsed_metrics, indent=2))
        return

    print("--- Truss 5G UPF Prometheus Telemetry ---")
    for line in body.splitlines():
        if line.startswith("# HELP") or line.startswith("# TYPE"):
            if args.verbose:
                print(f"\033[90m{line}\033[0m")
        elif line.strip():
            print(f"\033[36m{line}\033[0m")


def cmd_sessions(args: argparse.Namespace) -> None:
    """List active subscriber PDU sessions and policy rules."""
    status, body = fetch_endpoint(args.url, "/api/v1/sessions")
    if args.json:
        try:
            print(json.dumps(json.loads(body), indent=2))
        except json.JSONDecodeError:
            print(body)
        return

    try:
        sessions = json.loads(body)
        print("=================================================================")
        print(f" ACTIVE SUBSCRIBER PDU SESSIONS ({len(sessions)})")
        print("=================================================================")
        if not sessions:
            print(" No active sessions registered in the datapath.")
            print("=================================================================")
            return

        fmt = "{:<18} {:<18} {:<16} {:<12} {:<10}"
        print(fmt.format("LOCAL SEID", "CP SEID", "UE IP", "INGRESS TEID", "STATUS"))
        print("-" * 75)
        for s in sessions:
            print(fmt.format(
                str(s.get("local_seid", "-")),
                str(s.get("cp_seid", "-")),
                str(s.get("ue_ip", "-")),
                str(s.get("ingress_teid", "-")),
                str(s.get("state", "ACTIVE"))
            ))
        print("=================================================================")
    except json.JSONDecodeError:
        print(body)


def cmd_watch(args: argparse.Namespace) -> None:
    """Live updating terminal dashboard."""
    interval = max(0.5, float(args.interval))
    print(f"Connecting to live telemetry feed at {args.url} (poll interval: {interval}s)...")
    try:
        while True:
            # Clear screen
            sys.stdout.write("\033[2J\033[H")
            status, body = fetch_endpoint(args.url, "/metrics")
            metrics = {}
            for line in body.splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) >= 2:
                    metrics[parts[0]] = parts[1]

            ts = time.strftime("%Y-%m-%d %H:%M:%S")
            print("=================================================================")
            print(f" TRUSS 5G USER PLANE FUNCTION LIVE TELEMETRY  [{ts}]")
            print("=================================================================")
            print(f" Uptime (sec):              {metrics.get('truss_uptime_seconds', '0')}")
            print(f" Active PDU Sessions:       {metrics.get('truss_active_sessions', '0')}")
            print(f" Total Ingress Packets:     {metrics.get('truss_rx_packets_total', '0')}")
            print(f" Total Ingress Bytes:       {metrics.get('truss_rx_bytes_total', '0')}")
            print(f" Total Egress Packets:      {metrics.get('truss_tx_packets_total', '0')}")
            print(f" Total Egress Bytes:        {metrics.get('truss_tx_bytes_total', '0')}")
            print("-----------------------------------------------------------------")
            print(f" Drops (Unknown TEID):      {metrics.get('truss_drops_unknown_teid_total', '0')}")
            print(f" Drops (QER Rate Limit):    {metrics.get('truss_drops_rate_limit_total', '0')}")
            print(f" Drops (Gate Closed):       {metrics.get('truss_drops_gate_closed_total', '0')}")
            print("-----------------------------------------------------------------")
            print(f" PFCP Requests Processed:   {metrics.get('truss_pfcp_requests_total', '0')}")
            print(f" PFCP Responses Sent:       {metrics.get('truss_pfcp_responses_total', '0')}")
            print("=================================================================")
            print(" Press Ctrl+C to stop monitor.")
            time.sleep(interval)
    except KeyboardInterrupt:
        print("\nExiting monitor.")


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="trussctl",
        description="Administrative CLI for Truss 5G UPF & Packet Routing Fabric"
    )
    parser.add_argument(
        "--url",
        default="http://127.0.0.1:8080",
        help="Base URL of Truss management API (default: http://127.0.0.1:8080)"
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Format output as JSON"
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Enable verbose output"
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    # Health
    p_health = subparsers.add_parser("health", help="Check node health status")
    p_health.set_defaults(func=cmd_health)

    # Status
    p_status = subparsers.add_parser("status", help="Get node status and diagnostic summary")
    p_status.set_defaults(func=cmd_status)

    # Metrics
    p_metrics = subparsers.add_parser("metrics", help="Fetch Prometheus telemetry stream")
    p_metrics.set_defaults(func=cmd_metrics)

    # Sessions
    p_sessions = subparsers.add_parser("sessions", help="List active subscriber PDU sessions")
    p_sessions.set_defaults(func=cmd_sessions)

    # Watch
    p_watch = subparsers.add_parser("watch", help="Live terminal telemetry dashboard")
    p_watch.add_argument(
        "-i", "--interval",
        default=1.0,
        help="Refresh interval in seconds (default: 1.0)"
    )
    p_watch.set_defaults(func=cmd_watch)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
